APP_NAME="Manager Library"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 16 (ver plan.md §2 y data-model.md). Marcadores: los valores
# reales viven solo en .env (ignorado por git). Nunca credenciales aquí.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=library
DB_USERNAME=library
DB_PASSWORD=

# Token de sesión (JWT HS256, 8 h). La clave real va solo en .env.
JWT_SECRET=
JWT_TTL=28800

# Administrador inicial: lo crea el arranque desde el entorno, nunca el repo.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Portadas (clave opaca en la base; binario fuera) y CORS del frontend.
COVERS_DIR=./var/covers
CORS_ORIGIN=http://localhost:5173

FILESYSTEM_DISK=local
# Sin tablas de sesión/caché/colas en el esquema: usa almacenamiento local.
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file

VITE_APP_NAME="${APP_NAME}"
